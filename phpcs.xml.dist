<?phpxml version="1.0"?>
<ruleset name="CockpitConsole">
    <description>Coding standard for CockpitConsole</description>

    <!-- Paths to check -->
    <file>src/</file>
    <file>tests/</file>

    <!-- Exclude Kernel.php as it's generated by Symfony -->
    <exclude-pattern>src/Kernel.php</exclude-pattern>

    <!-- Show progress of the run -->
    <arg value="p"/>

    <!-- Use colors in output -->
    <arg name="colors"/>

    <!-- Show sniff codes in all reports -->
    <arg value="s"/>

    <!-- Only check PHP files -->
    <arg name="extensions" value="php"/>

    <!-- Use PSR-12 as the base standard -->
    <rule ref="PSR12">
        <!-- Relax some rules that might conflict with Symfony/Doctrine defaults or PHP-CS-Fixer -->
        <exclude name="PSR1.Methods.CamelCapsMethodName.NotCamelCaps"/>
        <!-- We use long snake_case or whatever for properties in entities sometimes -->
        <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace"/>
    </rule>

    <!-- Enforce line length -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/> <!-- 0 means no absolute limit (only warnings) -->
        </properties>
    </rule>

</ruleset>
