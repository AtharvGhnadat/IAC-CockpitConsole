<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>CockpitConsole - Dashboard</title>
    <style>
        body {
            font-family: sans-serif;
            background-color: #fff;
            margin: 0;
            padding: 20px;
        }
        .header {
            background-color: #333;
            color: white;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .user-info {
            font-size: 1.2em;
        }
        .session-info {
            font-size: 1em;
            color: #ccc;
        }
        .btn-lock {
            background-color: #d9534f;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            font-size: 1em;
            cursor: pointer;
            text-decoration: none;
        }
        .content {
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 8px;
        }
    </style>
</head>
<body>
    <div class="header">
        <div>
            <h1>CockpitConsole</h1>
            <div class="user-info">Welcome, {{ session.user.displayName }}</div>
            <div class="session-info">
                Role: {{ session.role }} | 
                Terminal: {{ terminal.terminalName }}
            </div>
        </div>
        <div>
            <div style="margin-bottom: 10px; text-align: right; color: #aaa;">
                Expires: <span id="timeRemaining">Calculating...</span>
            </div>
            <form action="{{ path('app_session_lock') }}" method="POST">
                <button type="submit" class="btn-lock">Lock Dashboard</button>
            </form>
        </div>
    </div>

    <div class="content">
        <h2>Production Dashboard (Placeholder)</h2>
        <p>This is a protected dashboard area. Business components will be implemented in future phases.</p>
    </div>

    <script>
        const expiryTime = new Date('{{ session.expiresAt|date('c') }}').getTime();
        
        function updateTimer() {
            const now = new Date().getTime();
            const distance = expiryTime - now;
            
            if (distance < 0) {
                document.getElementById('timeRemaining').innerHTML = "EXPIRED";
                window.location.reload(); // Will trigger redirect to lock
                return;
            }
            
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);
            
            document.getElementById('timeRemaining').innerHTML = minutes + "m " + seconds + "s";
        }
        
        setInterval(updateTimer, 1000);
        updateTimer();
    </script>
</body>
</html>
